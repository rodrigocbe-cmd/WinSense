<UserControl x:Class="WinSense.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinSense.App.ViewModels"
             xmlns:controls="clr-namespace:WinSense.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}">
    <UserControl.Resources>
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ComponentCard" DataType="{x:Type vm:ComponentCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource HideWhenEmpty}" FontSize="12" Margin="0,2,0,0" />

                    <DockPanel Margin="0,14,0,4">
                        <TextBlock Text="Uso" DockPanel.Dock="Left" VerticalAlignment="Bottom"
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding UsageText}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </DockPanel>
                    <controls:Sparkline Values="{Binding History}" Height="56"
                                        Stroke="{DynamicResource AccentFillColorDefaultBrush}" />

                    <TextBlock Text="{Binding Info}" Style="{StaticResource HideWhenEmpty}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource HideWhenEmpty}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding ComputerName}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ComputerModel}" Style="{StaticResource HideWhenEmpty}" FontSize="16" Margin="0,2,0,0" />

        <TextBlock Text="Monitor do PC" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,0" />
        <TextBlock Text="Uso e temperatura de cada componente, atualizados a cada segundo."
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HideWhenEmpty}" Margin="0,12,0,0" />

        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ComponentCard}" Margin="0,20,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
