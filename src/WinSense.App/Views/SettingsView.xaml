<UserControl x:Class="WinSense.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinSense.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Configurações" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Como o WinSense abre e continua rodando."
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Iniciar com o Windows" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,14"
                           Text="O WinSense abre sozinho quando você entra no Windows e fica nos ícones ocultos, perto do relógio, sem abrir a janela. Assim a conexão automática dos controles funciona desde o início." />
                <CheckBox Content="Iniciar o WinSense com o Windows" IsChecked="{Binding StartWithWindows}"
                          IsEnabled="{Binding CanChangeStartWithWindows}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HideWhenEmpty}" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12" Margin="0,14,0,0"
                           Text="Fechar a janela no X deixa o WinSense rodando nos ícones ocultos. Para encerrar, clique com o botão direito no ícone e escolha Sair." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
