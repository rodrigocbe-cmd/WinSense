<UserControl x:Class="WinSense.App.Views.BluetoothView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinSense.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BluetoothViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Bluetooth e Dispositivos" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Dispositivos Bluetooth pareados com este PC."
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20" />

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Conectar dispositivos automaticamente" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8"
                           Text="Às vezes um controle liga e chama o PC, mas não chega a conectar, obrigando a conectar pelas Configurações. Com esta opção, o WinSense percebe quando um controle marcado abaixo chama o PC e completa a conexão. Por padrão ele não chama os controles, para não ligá-los sozinho. Fones e caixas de som marcados são chamados a cada poucos segundos." />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,14"
                           Text="Se um dispositivo marcado “esquecer” o PC (por exemplo, um controle usado em outro aparelho), coloque-o em modo de pareamento (no DualShock 4: segure Share + PS até piscar rápido). O WinSense o reconhece e pareia de novo sozinho, sem passar pelas Configurações." />
                <CheckBox Content="Procurar e conectar dispositivos pareados" IsChecked="{Binding AutoConnect}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12" Margin="0,10,0,0"
                           Text="Funciona enquanto o WinSense estiver rodando, inclusive só nos ícones ocultos (veja Configurações › Iniciar com o Windows). Cada tentativa ocupa o Bluetooth por alguns segundos e pode causar pequenos cortes em fones Bluetooth. Ao conectar um fone, o Windows pode passar o som para ele." />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding AutoConnect, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button Content="Atualizar" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="14,4" />
                        <TextBlock Text="Dispositivos pareados" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Marque os que o WinSense deve conectar sozinho."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HideWhenEmpty}" Margin="0,8,0,0" />

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceGroup}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeviceRowViewModel}">
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" FontWeight="SemiBold"
                                                               VerticalAlignment="Top" Margin="12,0,0,0" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Address}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                                        <CheckBox Content="Conectar automaticamente" IsChecked="{Binding AutoConnect}"
                                                                  IsEnabled="{Binding CanAutoConnect}" Margin="0,4,0,0" />
                                                        <CheckBox Content="Chamar o controle (pode ligá-lo quando estiver desligado)"
                                                                  IsChecked="{Binding Call}" IsEnabled="{Binding AutoConnect}"
                                                                  Visibility="{Binding CanCall, Converter={StaticResource BoolToVisibility}}"
                                                                  Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource HideWhenEmpty}" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Últimas tentativas" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Aparecem aqui quando o WinSense tenta conectar ou parear de novo um dispositivo marcado."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
