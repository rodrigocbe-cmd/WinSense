<Window x:Class="WinSense.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinSense.App.Views"
        Title="WinSense" Height="560" Width="900" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="WinSense" FontSize="20" FontWeight="SemiBold" Margin="8,4,0,16" />
            <ListBox x:Name="Navigation" SelectedIndex="0" BorderThickness="0" Background="Transparent">
                <ListBoxItem Content="Bateria e Carga" />
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <views:BatteryView Margin="24" />
        </ScrollViewer>
    </Grid>
</Window>
