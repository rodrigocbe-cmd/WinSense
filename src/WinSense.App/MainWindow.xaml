<Window x:Class="WinSense.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSense" Height="680" Width="1040" MinHeight="420" MinWidth="680"
        Icon="Assets/WinSense.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,16">
                <Image Source="Assets/WinSense.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="WinSense" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryTextStyle}" Margin="8,0,0,4" />
            <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent"
                     SelectionChanged="Navigation_SelectionChanged">
                <ListBoxItem Content="Início" Tag="monitor" />
                <ListBoxItem Content="Bateria e Carga" Tag="battery" />
                <ListBoxItem Content="Bluetooth e Dispositivos" Tag="bluetooth" />
                <ListBoxItem Content="Teclado" Tag="keyboard" />
                <ListBoxItem Content="Configurações" Tag="settings" />
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="PageHost" Margin="24" />
        </ScrollViewer>
    </Grid>
</Window>
