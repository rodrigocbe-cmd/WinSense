<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinSense.Core\WinSense.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Forms is only used by TrayIcon; keep its names (Application, MessageBox...) out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\WinSense.ico" />
    <Resource Include="Assets\WinSense.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinSense</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from assets\logo.svg by scripts\make-icon.ps1 (same logo as the website). -->
    <ApplicationIcon>Assets\WinSense.ico</ApplicationIcon>
    <!-- Restore the publish runtime up front, so switching between build/test and publish
         doesn't re-restore and break the WPF markup-compile temp project (CS2001 on *.g.cs). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- WPF0001: the Fluent ThemeMode API is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
